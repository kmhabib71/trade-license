# ─── Database ─────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>/trade-license?retryWrites=true&w=majority"

# ─── Auth (Phase 1.5) ─────────────────────────────────────
# Secret for signing session JWTs
JWT_SECRET="change-me-generate-a-long-random-string"
# Optional pre-provisioned device tokens (colon-separated pairs)
DEVICE_TOKENS=""

# ─── Image storage: Cloudinary (Phase 2) ─────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder under which all app assets are stored in Cloudinary
CLOUDINARY_FOLDER="trade-license"

# ─── Extraction: Python OCR/crop service (Phase 3) ───────
PYTHON_SERVICE_URL="http://localhost:8000"

# ─── AI vision fallback (Phase 3.6) ──────────────────────
# Claude vision — used when OCR text is unclean/incomplete
ANTHROPIC_API_KEY=""

# ─── SMS gateway (Phase 7) ───────────────────────────────
# BD SMS gateway (e.g. bulksmsbd / SSL Wireless) — fill when creds available
SMS_GATEWAY_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
# WhatsApp (optional, pluggable later)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ই-ট্রেড লাইসেন্স ট্র্যাকার"
SUBSCRIPTION_MONTHLY_BDT="500"
